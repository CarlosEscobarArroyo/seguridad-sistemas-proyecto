# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Wazuh Indexer (OpenSearch). Si WAZUH_INDEXER_URL queda vacío, el agente usa
# alertas de ejemplo simuladas.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_SSL=true

# RAG: colección de Vector Search 2.0 (se crea e indexa con `uv run python -m app.rag`)
VECTOR_SEARCH_LOCATION=us-central1
VECTOR_SEARCH_COLLECTION=soc-conocimiento
EMBEDDING_MODEL=gemini-embedding-001

# Web simulada: evidencia y acciones de respuesta (/api/admin/* exige el token)
RAPPISIM_URL=
RAPPISIM_ADMIN_TOKEN=
RAPPISIM_SERVICE_NAME=rappi-web-simulada

# Investigaciones: "firestore" (por defecto) o "archivo" (JSON en reportes/, sin GCP)
INVESTIGACIONES_STORE=firestore

# Orígenes del navegador permitidos (el frontend de ChatKit en desarrollo)
ALLOW_ORIGINS=http://localhost:5174

# Control de acceso al publicar el servicio (vacío = sin comprobación, para local)
PANEL_USER=soc
PANEL_PASSWORD=
ALERTAS_SA_EMAIL=
SERVICE_URL=
